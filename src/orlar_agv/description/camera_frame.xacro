<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


<!--═══════════════════════════════════════════
        1.  VERTICAL POLE
    ═══════════════════════════════════════════ -->
    <xacro:property name="pole_radius"   value="0.01"/>   <!-- 3 cm diameter -->
    <xacro:property name="pole_length"   value="2.5"/>   <!-- chassis top → arm height -->
    <!-- pole base sits at chassis top: z_base = 0.3857
         pole centre z = 0.414 + pole_length/2 -->
    <xacro:property name="pole_z_centre" value="${0.3857 + pole_length/2}"/>

    <joint name="camera_pole_joint" type="fixed">
        <parent link="chassis"/>
        <child  link="camera_pole_link"/>
        <!-- Rear of the chassis body, centred laterally, sitting on chassis top -->
        <origin xyz="0.0 0.0 ${pole_z_centre}" rpy="0 0 0"/>
    </joint>

    <link name="camera_pole_link">
        <visual>
            <geometry>
                <cylinder radius="${pole_radius}" length="${pole_length}"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${pole_radius}" length="${pole_length}"/>
            </geometry>
        </collision>
        <!-- lightweight inertia so the URDF is dynamically valid -->
        <inertial>
            <mass value="0.3"/>
            <inertia ixx="0.006" ixy="0" ixz="0"
                     iyy="0.006" iyz="0"
                     izz="0.00003"/>
        </inertial>
    </link>

    <gazebo reference="camera_pole_link">
        <material>Gazebo/Green</material>
    </gazebo>


    <!--═══════════════════════════════════════════
         2.  HORIZONTAL ARM
        ═══════════════════════════════════════════ -->

    <xacro:property name="arm_radius"   value="0.03"/>
    <xacro:property name="arm_length"   value="1.22"/>   <!-- reaches to x = 0.5025 -->
    <!-- arm is attached to top of pole:
         pole top z (chassis frame) = 0.414 + pole_length = 1.231
         arm centre: x = arm_length/2, z = 1.231 (unchanged) -->

    <joint name="camera_arm_joint" type="fixed">
        <parent link="camera_pole_link"/>
        <child  link="camera_arm_link"/>
        <!--
            In camera_pole_link frame the top is at z = +pole_length/2.
            The arm extends along +X so its centre is at x = arm_length/2.
            rpy = 0 pi/2 0  rotates the cylinder axis from Z to X.
        -->
        <origin xyz="0 ${-arm_length/2} ${pole_length/2}" rpy="0 ${pi/2} ${-pi/2}"/>
    </joint>

    <link name="camera_arm_link">
        <visual>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_length}"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_length}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.004" ixy="0" ixz="0"
                     iyy="0.004" iyz="0"
                     izz="0.00002"/>
        </inertial>
    </link>

    <gazebo reference="camera_arm_link">
        <material>Gazebo/Green</material>
    </gazebo>


    <!-- ═══════════════════════════════════════════
         3.  MATERIAL DEFINITION (green)
         ═══════════════════════════════════════════ -->
    <!--
        'green' material is defined here so this file is self-contained.
        If robot_core.xacro is loaded first and already defines 'green',
        remove the block below to avoid duplicate-material warnings.
    -->
    <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
    </material>

</robot>
