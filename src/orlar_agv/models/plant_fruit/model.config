<?xml version="1.0"?>
<model>
  <name>plant_fruit</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>

  <author>
    <name>Generated for user upload</name>
  </author>

  <description>
    Simple procedural fruiting vegetable plant (e.g. ca chua / tomato) built
    from primitive geometry (cylinder pot + stem + sphere foliage + small red
    fruit spheres). No mesh file required. Base of the pot sits at local
    origin (z=0), so the pose's z value should equal the surface height you
    want it to sit on (e.g. the table top).
  </description>
</model>
