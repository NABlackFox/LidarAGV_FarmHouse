<?xml version="1.0"?>
<sdf version="1.7">
  <model name="plant_leafy">
    <static>true</static>

    <link name="link">

      <!-- POT -->
      <visual name="pot_visual">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.09</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.30 0.18 1</ambient>
          <diffuse>0.45 0.30 0.18 1</diffuse>
        </material>
      </visual>
      <collision name="pot_collision">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.09</length></cylinder></geometry>
      </collision>

      <!-- SOIL CAP -->
      <visual name="soil_visual">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.25 0.16 0.10 1</ambient>
          <diffuse>0.25 0.16 0.10 1</diffuse>
        </material>
      </visual>

      <!-- BUSHY FOLIAGE: cluster of overlapping green spheres -->
      <visual name="leaf_center">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><sphere><radius>0.075</radius></sphere></geometry>
        <material>
          <ambient>0.16 0.50 0.14 1</ambient>
          <diffuse>0.16 0.50 0.14 1</diffuse>
        </material>
      </visual>
      <visual name="leaf_n">
        <pose>0.045 0 0.13 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.20 0.55 0.16 1</ambient><diffuse>0.20 0.55 0.16 1</diffuse></material>
      </visual>
      <visual name="leaf_s">
        <pose>-0.045 0 0.13 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.20 0.55 0.16 1</ambient><diffuse>0.20 0.55 0.16 1</diffuse></material>
      </visual>
      <visual name="leaf_e">
        <pose>0 0.045 0.13 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.13 0.45 0.12 1</ambient><diffuse>0.13 0.45 0.12 1</diffuse></material>
      </visual>
      <visual name="leaf_w">
        <pose>0 -0.045 0.13 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.13 0.45 0.12 1</ambient><diffuse>0.13 0.45 0.12 1</diffuse></material>
      </visual>

      <!-- Single simplified collision for the whole foliage volume (cheap physics) -->
      <collision name="foliage_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><sphere><radius>0.09</radius></sphere></geometry>
      </collision>

    </link>
  </model>
</sdf>
